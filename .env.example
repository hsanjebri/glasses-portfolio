# Unsplash API access key — only needed by `npm run photos`, which registers
# the photos in content/photos.ts with Unsplash. The site never calls the API.
UNSPLASH_ACCESS_KEY=

# Booking emails (optional). With both set, each booking request is emailed to
# BOOKING_TO_EMAIL through Resend (https://resend.com). Without them, the form
# hands the request to WhatsApp instead.
RESEND_API_KEY=
BOOKING_TO_EMAIL=
# Sender address on a domain verified in Resend. Defaults to onboarding@resend.dev.
BOOKING_FROM_EMAIL=
